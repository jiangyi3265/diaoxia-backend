# 必填：数据库和令牌
DB_URL=jdbc:mysql://127.0.0.1:3306/diaoxia?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=GMT%2B8
DB_USERNAME=diaoxia_app
DB_PASSWORD=
TOKEN_SECRET=

# Redis 与文件存储
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
RUOYI_PROFILE=/data/diaoxia/upload
LOG_PATH=/www/wwwroot/dxjava/logs
XY_ORDER_EXPIRE_MINUTES=30
XY_OFFLINE_PAYMENT_EXPIRE_MINUTES=1440
XY_MEMBER_PENDING_ORDER_LIMIT=3
XY_MAINTENANCE_INTERVAL_MS=60000

# 管理端域名
CORS_ALLOWED_ORIGINS=https://admin.example.com
REFERER_ENABLED=true
# servicewechat.com is the Referer host used by WeChat mini-program image requests.
REFERER_ALLOWED_DOMAINS=admin.example.com,api.example.com,servicewechat.com

# 微信小程序与微信支付
XY_WECHAT_APP_ID=
XY_WECHAT_APP_SECRET=
# 预约订阅消息：模板字段名需与微信公众平台选用的模板保持一致
XY_WECHAT_SUBSCRIBE_RESERVATION_TEMPLATE_ID=
XY_WECHAT_SUBSCRIBE_RESERVATION_PAGE=pages/reserve/history
XY_WECHAT_SUBSCRIBE_RESERVATION_TITLE_FIELD=thing1
XY_WECHAT_SUBSCRIBE_RESERVATION_TIME_FIELD=time2
XY_WECHAT_PAY_MCH_ID=
XY_WECHAT_PAY_SERIAL_NO=
XY_WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat/apiclient_key.pem
XY_WECHAT_PAY_NOTIFY_URL=https://api.example.com/app/payments/wechat/notify
XY_WECHAT_PAY_REFUND_NOTIFY_URL=https://api.example.com/app/payments/wechat/refund-notify
XY_WECHAT_PAY_API_V3_KEY=
XY_WECHAT_PAY_PLATFORM_CERT_PATH=/run/secrets/wechat/platform_cert.pem

# 生产环境保持关闭
SWAGGER_ENABLED=false
DRUID_CONSOLE_ENABLED=false
SPRING_DEVTOOLS_RESTART_ENABLED=false
APP_LOG_LEVEL=info
